# Database Configuration (PostgreSQL 16 + pgvector)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/hackathon

# Google Gemini API Key (Fallback & Native Gemini models)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Permanent Heterogeneous Routing Tier)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# -----------------------------------------------------------------------------
# 10 Permanent (Non-Sunsetting) Heterogeneous Model Slugs
# -----------------------------------------------------------------------------
# A. Core Architecture, Deep Reasoning & Repo Auditing (550B MoE, 1M context)
MODEL_CORE_ARCH=nvidia/nemotron-3-ultra-550b-a55b:free

# B. High-Speed Parallel Council Engine (120B Latent MoE, MTP)
MODEL_HIGH_SPEED_COUNCIL=nvidia/nemotron-3-super-120b-a12b:free

# C. IDE Guardrails, Code Gen & 64K Reports (30B sparse MoE, 64K output)
MODEL_CODE_GUARDRAILS=cohere/north-mini-code:free

# D. Jury Profiler, Pitch Strategist & Mermaid Rewiring (30.7B multimodal)
MODEL_PROFILER_PITCH=google/gemma-4-31b-it:free
# Optional plan-specific overrides. Leave blank to use the existing profiler model.
MODEL_PLAN_DRAFT=
MODEL_PLAN_REVIEW=

# E. Stage 2 Web/GitHub Scraper & Recon Extraction (25.2B MoE)
MODEL_RECON_SCRAPER=google/gemma-4-26b-a4b-it:free

# F. Multimodal UX Visionary & Video/Audio Pitch Grader (30B Conv3D MoE)
MODEL_MULTIMODAL_UX=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# G. Security Gateway & Repo Injection Shield (4B multimodal guardrail)
MODEL_CONTENT_SAFETY=nvidia/nemotron-3.5-content-safety:free

# H. Primary Text/Code Embedder (32K context)
MODEL_TEXT_EMBEDDER=nvidia/nemotron-3-embed-1b:free

# I. Multimodal Document Embedder (PDF tables & infographics)
MODEL_MULTIMODAL_EMBEDDER=nvidia/llama-nemotron-embed-vl-1b-v2:free

# J. Second-Stage Cross-Encoder Reranker (+6-7% recall boost)
MODEL_RERANKER=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# Optional: Resend / SMTP for production password reset emails
RESEND_API_KEY=
EMAIL_FROM=noreply@vantage.dev

# -----------------------------------------------------------------------------
# API surface configuration
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. Defaults to the
# local dev origins (localhost:3000/3001) when unset. Never use "*" with
# credentials: browsers reject it, and it is a genuine security hole.
CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3000,http://localhost:3001

# Rate limit for the AI endpoints, per authenticated user (or per IP when
# signed out). Set RATE_LIMIT_ENABLED=false to turn it off in development.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Absolute URL of the frontend, used to build password reset links.
FRONTEND_URL=http://127.0.0.1:3000
GOOGLE_CLIENT_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Optional. Defaults to FRONTEND_URL/login and must match the GitHub OAuth app.
GITHUB_OAUTH_REDIRECT_URI=

# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional. Raises the GitHub API allowance for public repository search.
GITHUB_TOKEN=
